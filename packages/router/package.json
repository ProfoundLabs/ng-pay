{
  "name": "@ng-pay/router",
  "version": "0.1.9",
  "description": "Intelligent provider routing, failover, and circuit-breaking for the ng-pay SDK",
  "keywords": [
    "nigeria",
    "fintech",
    "payments",
    "failover",
    "circuit-breaker",
    "routing",
    "sdk"
  ],
  "author": "ng-pay contributors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm run test && pnpm run build && pnpm publish --no-git-checks"
  },
  "dependencies": {
    "@ng-pay/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ProfoundLabs/ng-pay.git",
    "directory": "packages/router"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
