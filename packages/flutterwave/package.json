{
  "name": "@ng-pay/flutterwave",
  "version": "0.1.1",
  "description": "Flutterwave adapter for the ng-pay unified Nigerian fintech SDK",
  "keywords": ["nigeria", "flutterwave", "payments", "fintech", "sdk", "africa"],
  "author": "ng-pay contributors",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ng-pay/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ProfoundLabs/ng-pay.git",
    "directory": "packages/core",
    "files": ["dist", "README.md"]
  }
}
